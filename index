<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pomodoro Focus - 番茄钟专注计时器</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
            min-height: 100vh;
            transition: background 0.8s;
            overflow-x: hidden;
        }
        body.mode-focus { background: linear-gradient(135deg, #1a0a2e, #2d1b4e, #1a0a2e); }
        body.mode-short { background: linear-gradient(135deg, #0a2e1a, #1b4e2d, #0a2e1a); }
        body.mode-long { background: linear-gradient(135deg, #0a1a2e, #1b2d4e, #0a1a2e); }

        /* 粒子 */
        .particles { position: fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:0; }
        .particle {
            position: absolute;
            border-radius: 50%;
            animation: drift linear infinite;
            opacity: 0.3;
        }
        @keyframes drift {
            0% { transform: translateY(100vh) rotate(0deg); opacity:0; }
            10% { opacity:0.3; }
            90% { opacity:0.3; }
            100% { transform: translateY(-10vh) rotate(360deg); opacity:0; }
        }

        header {
            text-align: center;
            padding: 30px 20px 10px;
            position: relative;
            z-index: 10;
        }
        header h1 { font-size: 28px; font-weight: 800; color: rgba(255,255,255,0.9); margin-bottom: 6px; }
        header p { color: rgba(255,255,255,0.4); font-size: 14px; }

        .container { max-width: 600px; margin: 0 auto; padding: 20px; position: relative; z-index: 10; }

        /* 模式选择 */
        .mode-tabs {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 40px;
        }
        .mode-tab {
            padding: 10px 24px;
            border: none;
            border-radius: 30px;
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.6);
            font-size: 14px;
            cursor: pointer;
            transition: 0.3s;
            font-weight: 500;
        }
        .mode-tab:hover { background: rgba(255,255,255,0.12); }
        .mode-tab.active { background: rgba(255,255,255,0.2); color: white; font-weight: 700; }

        /* 计时器圆环 */
        .timer-container {
            display: flex;
            justify-content: center;
            margin-bottom: 40px;
        }
        .timer-ring {
            position: relative;
            width: 300px;
            height: 300px;
        }
        .timer-ring svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }
        .ring-bg { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 8; }
        .ring-progress {
            fill: none;
            stroke-width: 8;
            stroke-linecap: round;
            transition: stroke-dashoffset 1s linear, stroke 0.8s;
        }
        .ring-glow {
            fill: none;
            stroke-width: 12;
            stroke-linecap: round;
            opacity: 0.15;
            filter: blur(6px);
            transition: stroke-dashoffset 1s linear, stroke 0.8s;
        }
        .timer-display {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }
        .timer-time {
            font-size: 72px;
            font-weight: 200;
            color: white;
            letter-spacing: 4px;
            font-variant-numeric: tabular-nums;
        }
        .timer-label {
            font-size: 14px;
            color: rgba(255,255,255,0.4);
            margin-top: 4px;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        /* 控制按钮 */
        .controls {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-bottom: 40px;
        }
        .ctrl-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            font-size: 22px;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .ctrl-btn.play {
            width: 72px;
            height: 72px;
            background: rgba(255,255,255,0.15);
            color: white;
            font-size: 26px;
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255,255,255,0.2);
        }
        .ctrl-btn.play:hover { background: rgba(255,255,255,0.25); transform: scale(1.08); }
        .ctrl-btn.secondary {
            background: rgba(255,255,255,0.06);
            color: rgba(255,255,255,0.5);
            border: 1px solid rgba(255,255,255,0.1);
        }
        .ctrl-btn.secondary:hover { background: rgba(255,255,255,0.12); color: white; }

        /* 统计卡片 */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
        }
        .stat-card .val { font-size: 28px; font-weight: 700; color: white; }
        .stat-card .lbl { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 4px; }

        /* 任务列表 */
        .tasks-section {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
        }
        .tasks-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        .tasks-header h3 { font-size: 16px; color: rgba(255,255,255,0.8); }
        .add-task-row {
            display: flex;
            gap: 8px;
            margin-bottom: 14px;
        }
        .task-input {
            flex: 1;
            padding: 10px 16px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            color: white;
            border-radius: 10px;
            font-size: 14px;
            outline: none;
        }
        .task-input:focus { border-color: rgba(255,255,255,0.3); }
        .task-input::placeholder { color: rgba(255,255,255,0.25); }
        .add-btn {
            padding: 10px 20px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.15);
            color: white;
            border-radius: 10px;
            cursor: pointer;
            font-size: 14px;
            transition: 0.2s;
        }
        .add-btn:hover { background: rgba(255,255,255,0.2); }

        .task-list { display: flex; flex-direction: column; gap: 8px; }
        .task-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: rgba(255,255,255,0.03);
            border-radius: 10px;
            transition: 0.2s;
        }
        .task-item:hover { background: rgba(255,255,255,0.06); }
        .task-check {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.2);
            background: none;
            cursor: pointer;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: transparent;
            flex-shrink: 0;
        }
        .task-check.done { background: #22c55e; border-color: #22c55e; color: white; }
        .task-text { flex: 1; font-size: 14px; color: rgba(255,255,255,0.7); }
        .task-text.done { text-decoration: line-through; color: rgba(255,255,255,0.3); }
        .task-pomos {
            font-size: 12px;
            color: rgba(255,255,255,0.3);
            min-width: 30px;
            text-align: center;
        }
        .task-del {
            background: none;
            border: none;
            color: rgba(255,255,255,0.15);
            cursor: pointer;
            font-size: 16px;
            padding: 4px;
            transition: 0.2s;
        }
        .task-del:hover { color: #f87171; }

        /* 设置面板 */
        .settings-section {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
        }
        .settings-section h3 { font-size: 16px; color: rgba(255,255,255,0.8); margin-bottom: 18px; }
        .setting-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .setting-row:last-child { border: none; }
        .setting-label { font-size: 14px; color: rgba(255,255,255,0.6); }
        .setting-control { display: flex; align-items: center; gap: 8px; }
        .adj-btn {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.15);
            background: rgba(255,255,255,0.06);
            color: white;
            cursor: pointer;
            font-size: 16px;
            transition: 0.2s;
        }
        .adj-btn:hover { background: rgba(255,255,255,0.15); }
        .setting-val {
            font-size: 16px;
            font-weight: 600;
            color: white;
            min-width: 36px;
            text-align: center;
        }

        /* 历史记录 */
        .history-section {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 24px;
        }
        .history-section h3 { font-size: 16px; color: rgba(255,255,255,0.8); margin-bottom: 16px; }
        .history-list { display: flex; flex-direction: column; gap: 8px; }
        .history-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 14px;
            background: rgba(255,255,255,0.03);
            border-radius: 8px;
            font-size: 13px;
        }
        .history-item .h-date { color: rgba(255,255,255,0.4); }
        .history-item .h-count { color: #22c55e; font-weight: 600; }
        .history-empty { text-align: center; color: rgba(255,255,255,0.2); padding: 20px; font-size: 14px; }

        /* 通知 */
        .toast {
            position: fixed;
            top: 24px;
            right: 24px;
            background: rgba(30,30,50,0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
            color: white;
            padding: 14px 24px;
            border-radius: 14px;
            font-size: 14px;
            opacity: 0;
            transform: translateX(30px);
            transition: 0.3s;
            z-index: 200;
        }
        .toast.show { opacity: 1; transform: translateX(0); }

        /* 声音 */
        .sound-toggle {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.06);
            color: white;
            cursor: pointer;
            font-size: 18px;
            z-index: 10;
            transition: 0.2s;
        }
        .sound-toggle:hover { background: rgba(255,255,255,0.12); }

        @media (max-width: 600px) {
            .timer-ring { width: 240px; height: 240px; }
            .timer-time { font-size: 52px; }
            .stats-row { grid-template-columns: repeat(3, 1fr); gap: 8px; }
            .stat-card { padding: 14px; }
            .stat-card .val { font-size: 22px; }
            .mode-tab { padding: 8px 16px; font-size: 13px; }
        }
    </style>
</head>
<body class="mode-focus">
    <div class="particles" id="particles"></div>

    <header>
        <h1>🍅 Pomodoro Focus</h1>
        <p>专注工作，高效休息</p>
    </header>

    <div class="container">
        <!-- 模式选择 -->
        <div class="mode-tabs">
            <button class="mode-tab active" onclick="setMode('focus')">🎯 专注</button>
            <button class="mode-tab" onclick="setMode('short')">☕ 短休息</button>
            <button class="mode-tab" onclick="setMode('long')">🌿 长休息</button>
        </div>

        <!-- 计时器 -->
        <div class="timer-container">
            <div class="timer-ring">
                <svg viewBox="0 0 300 300">
                    <circle class="ring-bg" cx="150" cy="150" r="140"/>
                    <circle class="ring-glow" cx="150" cy="150" r="140"
                            id="ringGlow"
                            stroke="#a855f7"
                            stroke-dasharray="879.6"
                            stroke-dashoffset="0"/>
                    <circle class="ring-progress" cx="150" cy="150" r="140"
                            id="ringProgress"
                            stroke="#a855f7"
                            stroke-dasharray="879.6"
                            stroke-dashoffset="0"/>
                </svg>
                <div class="timer-display">
                    <div class="timer-time" id="timerDisplay">25:00</div>
                    <div class="timer-label" id="timerLabel">专注时间</div>
                </div>
            </div>
        </div>

        <!-- 控制按钮 -->
        <div class="controls">
            <button class="ctrl-btn secondary" onclick="resetTimer()" title="重置">🔄</button>
            <button class="ctrl-btn play" id="playBtn" onclick="toggleTimer()">▶</button>
            <button class="ctrl-btn secondary" onclick="skipTimer()" title="跳过">⏭</button>
        </div>

        <!-- 统计 -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="val" id="pomodoroCount">0</div>
                <div class="lbl">🍅 今日番茄</div>
            </div>
            <div class="stat-card">
                <div class="val" id="focusMinutes">0</div>
                <div class="lbl">⏱ 专注分钟</div>
            </div>
            <div class="stat-card">
                <div class="val" id="tasksDone">0</div>
                <div class="lbl">✅ 完成任务</div>
            </div>
        </div>

        <!-- 任务列表 -->
        <div class="tasks-section">
            <div class="tasks-header">
                <h3>📋 任务列表</h3>
            </div>
            <div class="add-task-row">
                <input class="task-input" id="taskInput" placeholder="添加一个任务..." maxlength="50"
                       onkeydown="if(event.key==='Enter')addTask()">
                <button class="add-btn" onclick="addTask()">添加</button>
            </div>
            <div class="task-list" id="taskList"></div>
        </div>

        <!-- 设置 -->
        <div class="settings-section">
            <h3>⚙️ 计时设置</h3>
            <div class="setting-row">
                <span class="setting-label">🎯 专注时长（分钟）</span>
                <div class="setting-control">
                    <button class="adj-btn" onclick="adjustSetting('focus',-5)">−</button>
                    <span class="setting-val" id="setFocus">25</span>
                    <button class="adj-btn" onclick="adjustSetting('focus',5)">＋</button>
                </div>
            </div>
            <div class="setting-row">
                <span class="setting-label">☕ 短休息时长（分钟
